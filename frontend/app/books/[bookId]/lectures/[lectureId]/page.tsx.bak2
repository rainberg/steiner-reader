'use client';

import { useEffect, useState, useRef, useCallback } from 'react';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';
import { fetchLecture, translateLecture, getTranslationStatus, fetchBookImages, getStoredUser, getTranslationCost, Lecture, Sentence, BookImage, TranslationCost } from '@/lib/api';

type ReadingMode = 'de-zh' | 'de-only' | 'zh-only';

export default function LecturePage() {
  const params = useParams();
  const router = useRouter();
  const bookId = Number(params.bookId);
  const lectureId = Number(params.lectureId);

  const [lecture, setLecture] = useState<Lecture | null>(null);
  const [images, setImages] = useState<BookImage[]>([]);
  const [loading, setLoading] = useState(true);
  const [mode, setMode] = useState<ReadingMode>('de-only');
  const [translating, setTranslating] = useState(false);
  const [translateMsg, setTranslateMsg] = useState<string | null>(null);
  const [lightboxImg, setLightboxImg] = useState<string | null>(null);
  const [costInfo, setCostInfo] = useState<TranslationCost | null>(null);
  const [userCredits, setUserCredits] = useState<number | null>(null);
  const [showTranslation, setShowTranslation] = useState<Set<number>>(new Set());
  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const loadLecture = useCallback(async () => {
    try {
      const [data, imgs] = await Promise.all([
        fetchLecture(bookId, lectureId),
        fetchBookImages(bookId).catch(() => []),
      ]);
      setLecture(data);
      setImages(imgs);
      const hasAnyTranslation = data.paragraphs.some(p => p.sentences.some(s => s.text_zh));
      if (hasAnyTranslation && mode === 'de-only') setMode('de-zh');

      try {
        const cost = await getTranslationCost(lectureId);
        setCostInfo(cost);
        if (cost.user_credits !== null) setUserCredits(cost.user_credits);
      } catch {}
    } catch {
      router.push(`/books/${bookId}`);
    } finally {
      setLoading(false);
    }
  }, [bookId, lectureId, router, mode]);

  useEffect(() => {
    loadLecture();
    return () => { if (pollingRef.current) clearInterval(pollingRef.current); };
  }, [loadLecture]);

  const startPolling = () => {
    if (pollingRef.current) clearInterval(pollingRef.current);
    pollingRef.current = setInterval(async () => {
      try {
        const status = await getTranslationStatus(lectureId);
        if (status.completed) {
          if (pollingRef.current) clearInterval(pollingRef.current);
          setTranslating(false);
          setTranslateMsg(`✅ 翻译完成: ${status.translated} 句`);
          await loadLecture();
          setMode('de-zh');
        } else {
          setTranslateMsg(`⏳ 翻译中: ${status.translated}/${status.total} 句`);
        }
      } catch {}
    }, 3000);
  };

  const handleTranslate = async () => {
    const user = getStoredUser();
    if (!user) { router.push('/login'); return; }

    setTranslating(true);
    setTranslateMsg('⏳ 启动翻译...');
    try {
      const res = await translateLecture(lectureId);
      if (res.status === 'already_translated') {
        setTranslating(false);
        setTranslateMsg('✅ 已翻译');
        await loadLecture();
        setMode('de-zh');
      } else {
        setTranslateMsg(`⏳ 翻译中: 0/${res.total} 句`);
        if (res.credits !== undefined) setUserCredits(res.credits);
        startPolling();
      }
    } catch (err: any) {
      setTranslating(false);
      setTranslateMsg(`❌ ${err.message}`);
    }
  };

  // Toggle translation for a specific sentence (click to show/hide)
  const toggleSentence = (id: number) => {
    setShowTranslation(prev => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  if (loading) return <div className="min-h-screen flex items-center justify-center"><div className="animate-spin w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full"></div></div>;
  if (!lecture) return null;

  const totalSentences = lecture.paragraphs.reduce((sum, p) => sum + p.sentences.length, 0);
  const translatedSentences = lecture.paragraphs.reduce((sum, p) => sum + p.sentences.filter(s => s.text_zh).length, 0);
  const allTranslated = translatedSentences === totalSentences && totalSentences > 0;
  const user = getStoredUser();

  // Build image lookup by paragraph index
  const imagesByParagraph: Record<number, BookImage[]> = {};
  for (const img of images) {
    if (img.paragraph_index !== null && img.paragraph_index !== undefined) {
      if (!imagesByParagraph[img.paragraph_index]) imagesByParagraph[img.paragraph_index] = [];
      imagesByParagraph[img.paragraph_index].push(img);
    }
  }

  return (
    <main className="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
      {/* Lightbox */}
      {lightboxImg && (
        <div className="fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4 cursor-pointer" onClick={() => setLightboxImg(null)}>
          <img src={lightboxImg} className="max-w-full max-h-full object-contain rounded-lg" alt="插图放大" />
        </div>
      )}

      {/* Sticky header */}
      <div className="sticky top-0 bg-white/90 backdrop-blur-sm border-b border-slate-200 z-10">
        <div className="max-w-4xl mx-auto px-4 py-2.5">
          <div className="flex items-center justify-between flex-wrap gap-2">
            <Link href={`/books/${bookId}`} className="text-blue-600 hover:text-blue-800 text-sm font-medium flex items-center gap-1">
              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" /></svg>
              返回目录
            </Link>
            <div className="flex items-center gap-2">
              {/* Reading mode toggle */}
              <div className="flex bg-slate-100 rounded-lg p-0.5">
                {(['de-zh', 'de-only', 'zh-only'] as ReadingMode[]).map(m => (
                  <button key={m} onClick={() => setMode(m)}
                    disabled={m === 'de-zh' ? (!allTranslated && translatedSentences === 0) : m === 'zh-only' ? translatedSentences === 0 : false}
                    className={`px-2.5 py-1 rounded-md text-xs font-medium transition ${mode === m ? 'bg-white shadow text-slate-900' : 'text-slate-500 hover:text-slate-700'} ${(m === 'de-zh' && !allTranslated && translatedSentences === 0) || (m === 'zh-only' && translatedSentences === 0) ? 'opacity-40 cursor-not-allowed' : ''}`}
                  >
                    {m === 'de-zh' ? '德中' : m === 'de-only' ? '德语' : '中文'}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Translation message */}
      {translateMsg && (
        <div className="max-w-4xl mx-auto px-4 mt-3">
          <div className={`text-sm px-3 py-2 rounded-lg ${translateMsg.startsWith('✅') ? 'bg-green-50 text-green-700' : translateMsg.startsWith('❌') ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700'}`}>
            {translateMsg}
          </div>
        </div>
      )}

      <div className="max-w-4xl mx-auto px-4 py-6">
        {/* Title */}
        <div className="mb-6">
          <h1 className="text-xl font-bold text-slate-900 leading-tight">{lecture.title_de || 'Vortrag'}</h1>
          <div className="text-sm text-slate-500 mt-1.5 flex items-center gap-3 flex-wrap">
            {lecture.location && <span>📍 {lecture.location}</span>}
            {lecture.lecture_date && <span>📅 {lecture.lecture_date}</span>}
            <span>📄 {lecture.paragraphs.length} 段</span>
            <span>💬 {translatedSentences}/{totalSentences} 已译</span>
          </div>
        </div>

        {/* Translate button */}
        {!allTranslated && !translating && (
          <div className="mb-6 bg-gradient-to-r from-blue-50 to-emerald-50 rounded-xl p-5 border border-blue-100/50 text-center">
            <p className="text-slate-600 text-sm mb-2">
              {translatedSentences === 0 ? '本篇尚未翻译' : `已翻译 ${translatedSentences}/${totalSentences} 句`}
            </p>
            {user ? (
              <button onClick={handleTranslate}
                className="px-5 py-2 rounded-lg text-sm font-medium transition shadow-sm bg-blue-600 text-white hover:bg-blue-700">
                🌐 翻译本篇 ({costInfo?.cost || 10} 点) · 余额 {userCredits ?? user.credits}
              </button>
            ) : (
              <Link href="/login" className="inline-block px-5 py-2 rounded-lg text-sm font-medium bg-slate-400 text-white hover:bg-slate-500 transition">
                🔑 登录后翻译
              </Link>
            )}
          </div>
        )}

        {translating && (
          <div className="mb-6 bg-amber-50 rounded-xl p-5 border border-amber-100 text-center animate-pulse">
            <p className="text-amber-700">⏳ 翻译进行中...</p>
          </div>
        )}

        {/* Tip for click-to-translate mode */}
        {allTranslated && mode === 'de-only' && (
          <div className="mb-4 text-xs text-slate-400 text-center">
            💡 点击句子可查看中文翻译
          </div>
        )}

        {/* Content */}
        <div className="space-y-5">
          {lecture.paragraphs.map((para, pi) => (
            <div key={para.id}>
              <div className="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
                <div className="text-xs text-slate-300 mb-2 font-mono">¶{pi + 1}</div>
                <div className="space-y-2.5">
                  {para.sentences.map((sent, si) => (
                    <SentenceView
                      key={sent.id}
                      sentence={sent}
                      mode={mode}
                      index={si + 1}
                      showZh={showTranslation.has(sent.id)}
                      onToggle={() => toggleSentence(sent.id)}
                    />
                  ))}
                </div>
              </div>
              {/* Images after this paragraph */}
              {imagesByParagraph[pi]?.map((img) => (
                <div key={img.id} className="mt-3 flex justify-center">
                  <div
                    className="bg-white rounded-xl border border-slate-100 overflow-hidden shadow-sm cursor-pointer hover:shadow-md transition max-w-lg"
                    onClick={() => setLightboxImg(img.url)}
                  >
                    <img src={img.url} alt="插图" className="w-full h-auto object-contain" loading="lazy" />
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>

        {/* Bottom navigation */}
        <div className="mt-8 text-center">
          <Link href={`/books/${bookId}`} className="text-blue-600 hover:underline text-sm">← 返回目录</Link>
        </div>
      </div>
    </main>
  );
}

function SentenceView({ sentence, mode, index, showZh, onToggle }: {
  sentence: Sentence;
  mode: ReadingMode;
  index: number;
  showZh: boolean;
  onToggle: () => void;
}) {
  const hasTranslation = !!sentence.text_zh;
  const [localShow, setLocalShow] = useState(false);
  const isZhVisible = mode === 'de-zh' || mode === 'zh-only' || showZh || localShow;

  if (mode === 'zh-only') {
    return (
      <div className="flex items-start gap-2">
        <span className="text-slate-300 text-xs mt-0.5 w-5 text-right select-none font-mono shrink-0">{index}</span>
        {hasTranslation
          ? <p className="text-slate-700 leading-relaxed text-[15px]">{sentence.text_zh}</p>
          : <p className="text-slate-300 italic text-sm">（未翻译）</p>
        }
      </div>
    );
  }

  if (mode === 'de-only' && !showZh && !localShow) {
    return (
      <div className="flex items-start gap-2 group cursor-pointer" onClick={() => hasTranslation && setLocalShow(true)}>
        <span className="text-slate-300 text-xs mt-0.5 w-5 text-right select-none font-mono shrink-0">{index}</span>
        <p className="text-slate-800 leading-relaxed text-[15px] group-hover:text-blue-700 transition">{sentence.text_de}</p>
        {hasTranslation && (
          <span className="shrink-0 text-[10px] text-blue-400 opacity-0 group-hover:opacity-100 transition mt-1">译</span>
        )}
      </div>
    );
  }

  return (
    <div className="flex items-start gap-2">
      <span className="text-slate-300 text-xs mt-0.5 w-5 text-right select-none font-mono shrink-0">{index}</span>
      <div className="flex-1">
        <p className="text-slate-800 leading-relaxed text-[15px]">{sentence.text_de}</p>
        {hasTranslation && (
          <p className="text-slate-500 text-sm mt-1 leading-relaxed">{sentence.text_zh}</p>
        )}
      </div>
    </div>
  );
}
