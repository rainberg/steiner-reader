const API_BASE = process.env.NEXT_PUBLIC_API_BASE || '';

export interface Book {
  id: number;
  ga_number: string;
  title_de: string;
  title_zh?: string;
  subtitle_de?: string;
  subtitle_zh?: string;
  cover_image_url?: string;
  publication_year?: number;
  lectures: Lecture[];
}

export interface Lecture {
  id: number;
  book_id: number;
  order_index: number;
  title_de: string;
  title_zh?: string;
  lecture_date?: string;
  location?: string;
  level?: string;
  type?: string;
  sentence_count: number;
  paragraph_count: number;
  image_count?: number;
}

export interface Paragraph {
  id: number;
  lecture_id: number;
  paragraph_index: number;
  content_de: string;
  content_zh?: string;
}

export interface Sentence {
  id: number;
  paragraph_id: number;
  sentence_index: number;
  content_de: string;
  content_zh?: string;
  is_heading?: boolean;
}

export interface SearchResult {
  sentence: Sentence;
  paragraph: Paragraph;
  lecture: Lecture;
  book: Book;
  rank: number;
}

// ────────────────────────
// Books
// ────────────────────────

export async function fetchBooks(): Promise<Book[]> {
  const res = await fetch(`${API_BASE}/api/books`);
  if (!res.ok) throw new Error(`fetchBooks failed: ${res.status}`);
  return res.json();
}

export async function fetchBook(bookId: number): Promise<Book> {
  const res = await fetch(`${API_BASE}/api/books/${bookId}`);
  if (!res.ok) {
    if (res.status === 404) throw new Error('Book not found');
    throw new Error(`fetchBook failed: ${res.status}`);
  }
  return res.json();
}

// ────────────────────────
// Lectures
// ────────────────────────

export async function fetchLectures(bookId: number): Promise<Lecture[]> {
  const res = await fetch(`${API_BASE}/api/books/${bookId}/lectures`);
  if (!res.ok) throw new Error(`fetchLectures failed: ${res.status}`);
  return res.json();
}

export async function fetchLecture(lectureId: number): Promise<Lecture> {
  const res = await fetch(`${API_BASE}/api/lectures/${lectureId}`);
  if (!res.ok) throw new Error(`fetchLecture failed: ${res.status}`);
  return res.json();
}

// ────────────────────────
// Paragraphs / Sentences
// ────────────────────────

export async function fetchParagraphs(lectureId: number): Promise<Paragraph[]> {
  const res = await fetch(`${API_BASE}/api/lectures/${lectureId}/paragraphs`);
  if (!res.ok) throw new Error(`fetchParagraphs failed: ${res.status}`);
  return res.json();
}

export async function fetchSentences(paragraphId: number): Promise<Sentence[]> {
  const res = await fetch(`${API_BASE}/api/paragraphs/${paragraphId}/sentences`);
  if (!res.ok) throw new Error(`fetchSentences failed: ${res.status}`);
  return res.json();
}

// ────────────────────────
// Search
// ────────────────────────

export async function searchSentences(
  query: string,
  limit = 20,
  offset = 0
): Promise<SearchResult[]> {
  const res = await fetch(
    `${API_BASE}/api/search/sentences?q=${encodeURIComponent(query)}&limit=${limit}&offset=${offset}`
  );
  if (!res.ok) throw new Error(`search failed: ${res.status}`);
  return res.json();
}

// ────────────────────────
// Translation helpers
// ────────────────────────

export async function fetchTranslation(paragraphId: number, targetLang = 'zh'): Promise<string> {
  const res = await fetch(`${API_BASE}/api/paragraphs/${paragraphId}/translate?target_lang=${targetLang}`);
  if (!res.ok) throw new Error(`translation failed: ${res.status}`);
  const data = await res.json();
  return data.translation;
}

export async function batchTranslate(
  paragraphIds: number[],
  targetLang = 'zh'
): Promise<Record<number, string>> {
  const res = await fetch(`${API_BASE}/api/paragraphs/batch-translate`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ paragraph_ids: paragraphIds, target_lang: targetLang }),
  });
  if (!res.ok) throw new Error(`batchTranslate failed: ${res.status}`);
  return res.json();
}
